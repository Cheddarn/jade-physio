rules_version = '2';

// Roles (collection "access", keyed by lowercase email):
//   admin     - front desk; everything except restock orders, costs and profit
//   manager   - everything except the access list, plus restock orders, costs and profit
//   therapist - read schedule and patients; can only start/finish their own sessions
//   cleaning  - patient flow only: mark shoes changed / returned
//   patient   - self-registered; own portal account and own booking requests only
service cloud.firestore {
  match /databases/{database}/documents {

    // Who is asking: the email for staff (and older accounts), the phone number (+62...) for patients who sign in by SMS.
    // access/ and accounts/ docs are keyed by the same value.
    function myId() {
      return request.auth.token.get('email', null) != null
        ? request.auth.token.email.lower()
        : request.auth.token.get('phone_number', '');
    }
    function signedIn() {
      return request.auth != null && myId() != '';
    }
    function accessPath() {
      return /databases/$(database)/documents/access/$(myId());
    }
    function member() {
      return signedIn() && exists(accessPath());
    }
    // Front desk used to be its own role ('staff'); it is now admin, and old access docs still say 'staff'.
    function role() {
      let r = get(accessPath()).data.role;
      return r == 'staff' ? 'admin' : r;
    }
    function isAdmin() {
      return member() && role() == 'admin';
    }
    // The manager role only: restock orders, costs and profit.
    function managerOnly() {
      return member() && role() == 'manager';
    }
    // Admin and manager: catalogue, reports, voids.
    function isManager() {
      return member() && role() in ['admin', 'manager'];
    }
    function isDesk() {
      return member() && role() in ['admin', 'manager'];
    }
    function isCleaning() {
      return member() && role() == 'cleaning';
    }
    function isPatient() {
      return member() && role() == 'patient';
    }
    // Everyone who works at the clinic.
    function staffRole() {
      return member() && role() in ['admin', 'manager', 'therapist', 'cleaning'];
    }
    // Who may read patient records: not cleaning, not patients.
    function clinical() {
      return member() && role() in ['admin', 'manager', 'therapist'];
    }
    function isTherapist() {
      return member() && role() == 'therapist';
    }
    function myStaffId() {
      return get(accessPath()).data.staffId;
    }
    function setupDone() {
      return exists(/databases/$(database)/documents/meta/setup);
    }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- access list ----------
    match /access/{email} {
      allow read: if signedIn() && (myId() == email || isAdmin());
      // Admins add people. The very first account may add itself as admin once,
      // in the same batch that creates meta/setup.
      allow create: if isAdmin()
        || (signedIn() && myId() == email && !setupDone()
            && existsAfter(/databases/$(database)/documents/meta/setup)
            && request.resource.data.role == 'admin')
        // Patients sign up themselves, as patients only.
        || (signedIn() && myId() == email && setupDone()
            && request.resource.data.role == 'patient');
      // Nobody can change or remove their own access.
      allow update, delete: if isAdmin() && myId() != email;
    }

    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone()
        && existsAfter(/databases/$(database)/documents/access/$(myId()));
      allow update, delete: if false;
    }

    // Invoice number counter, bumped inside every checkout.
    match /meta/counters {
      allow read, write: if isDesk();
    }

    // Opening hours and the package reminder window.
    match /meta/settings {
      allow read: if member();
      allow write: if isManager();
    }

    // ---------- team, shifts, attendance ----------
    match /team/{email} {
      allow read: if staffRole();
      allow write: if isManager();
    }

    // Doc id = email_YYYY-MM-DD. Everyone clocks themselves in and out.
    match /attendance/{id} {
      allow read: if isManager() || (staffRole() && (resource == null || resource.data.email == myId()));
      allow create: if staffRole()
        && request.resource.data.email == myId()
        && id == myId() + '_' + request.resource.data.dateKey;
      allow update: if isManager()
        || (resource.data.email == myId() && onlyChanged(['outAt', 'overtimeMin', 'closing', 'note']));
      allow delete: if isManager();
    }

    // ---------- restock requests ----------
    match /restock/{id} {
      allow read: if staffRole();
      allow create: if staffRole() && request.resource.data.createdBy == myId()
        && request.resource.data.done == false && request.resource.data.status == 'requested';
      // The manager orders (name, quantity, status). Anyone at the clinic confirms an ordered item arrived, or undoes that.
      // Whoever asked may still change or withdraw their request until it is ordered.
      allow update: if managerOnly()
        || (staffRole() && onlyChanged(['status', 'done', 'doneAt', 'doneBy', 'doneByName'])
            && resource.data.get('status', 'requested') in ['ordered', 'received']
            && request.resource.data.status in ['ordered', 'received'])
        || (resource.data.createdBy == myId() && resource.data.done == false
            && resource.data.get('status', 'requested') == 'requested'
            && request.resource.data.get('status', 'requested') == 'requested');
      allow delete: if managerOnly()
        || (resource.data.createdBy == myId() && resource.data.done == false
            && resource.data.get('status', 'requested') == 'requested');
    }

    // Costs (restock prices and fees the manager adds), for the profit report. The manager only.
    match /expenses/{id} {
      allow read, write: if managerOnly();
    }

    // ---------- therapy reports (doc id = booking id) ----------
    match /reports/{id} {
      allow read: if clinical();
      allow create, update: if isDesk()
        || (isTherapist() && request.resource.data.staffId == myStaffId()
            && (resource == null || resource.data.staffId == myStaffId()));
      allow delete: if isManager();
    }

    // ---------- patient portal ----------
    match /accounts/{email} {
      allow read: if (signedIn() && myId() == email) || isDesk();
      allow write: if signedIn() && myId() == email;
    }

    // The desk's own dated reminders (Pengingat).
    match /memos/{id} {
      allow read, create, update, delete: if isDesk();
    }

    match /requests/{id} {
      allow read: if isDesk() || (isPatient() && resource.data.accountEmail == myId());
      allow create: if isPatient()
        && request.resource.data.accountEmail == myId()
        && request.resource.data.status == 'pending';
      // The desk confirms or rejects; the patient may only cancel while it's pending.
      allow update: if isDesk()
        || (isPatient() && resource.data.accountEmail == myId()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && onlyChanged(['status']));
      allow delete: if false;
    }

    // ---------- catalogue ----------
    // Physios' names are public to patients too (they pick one when booking).
    match /staff/{id} {
      allow read: if member();
      allow write: if isManager();
    }
    match /services/{id} {
      allow read: if member();
      allow write: if isManager();
    }
    match /packages/{id} {
      allow read: if member();
      allow write: if isManager();
    }

    // ---------- operations ----------
    match /customers/{id} {
      allow read: if clinical();
      allow create, update: if isDesk();
      allow delete: if isManager();
    }

    match /bookings/{id} {
      allow read: if clinical();
      allow create, delete: if isDesk();
      allow update: if isDesk()
        || (isTherapist()
            && resource.data.staffId == myStaffId()
            && onlyChanged(['status'])
            && resource.data.status in ['booked', 'in_session']
            && request.resource.data.status in ['booked', 'in_session']);
    }

    match /vouchers/{id} {
      allow read: if member();
      // Staff create vouchers only by selling a package; manual vouchers are admin-only.
      allow create: if isManager() || (isDesk() && request.resource.data.source == 'sale');
      // Staff redeem sessions at checkout but cannot void a voucher.
      allow update: if isManager() || (isDesk() && request.resource.data.status != 'void');
      allow delete: if false;
    }

    match /sales/{id} {
      allow read, create: if isDesk();
      // Managers void invoices; the desk may only attach a receipt link to an old one.
      allow update: if isManager() || (isDesk() && onlyChanged(['receiptToken']));
      allow delete: if false;
    }

    // Discounts the manager sets up; the front desk picks from them at checkout.
    match /discounts/{id} {
      allow read: if staffRole();
      allow write: if isManager();
    }

    // Public receipts: anyone holding the exact link can open one, nobody can list them.
    match /receipts/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isDesk();
      allow update: if isManager();
      allow delete: if false;
    }

    // ---------- patient flow (walk-in, shoes, bed) ----------
    match /visits/{id} {
      allow read: if staffRole();
      allow create, delete: if isDesk();
      allow update: if isDesk()
        // Cleaning service: shoe changes only.
        || (isCleaning()
            && onlyChanged(['shoes', 'shoeRack', 'shoesChangedAt', 'shoesChangedBy',
                            'shoesReturnedAt', 'shoesReturnedBy', 'closedAt']))
        // Therapist: start and finish their own patient's session.
        || (isTherapist()
            && resource.data.staffId == myStaffId()
            && onlyChanged(['stage', 'startedAt', 'endedAt', 'closedAt'])
            && request.resource.data.stage in ['waiting', 'in_session', 'finished']);
    }
  }
}
